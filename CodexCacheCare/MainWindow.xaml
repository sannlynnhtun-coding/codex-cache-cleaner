<Window x:Class="CodexCacheCare.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Codex Cache Care">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root" RowDefinitions="*,Auto">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="800" Margin="32,26,32,24" Spacing="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="STORAGE MAINTENANCE" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="Codex Cache Care" Style="{StaticResource TitleLargeTextBlockStyle}" />
                    <TextBlock Text="Find rebuildable Codex files and choose what to clear." TextWrapping="Wrap" />
                </StackPanel>
                <Border Padding="20,16" CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Cache found" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="Total" Text="—" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock x:Name="FileCount" Text="Scan to see what can be cleared." TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="ScanButton" Grid.Column="1" Content="Scan cache"
                                VerticalAlignment="Center" Click="ScanClicked" />
                    </Grid>
                </Border>
                <StackPanel Spacing="10">
                    <TextBlock Text="Cleanup categories" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <StackPanel x:Name="Categories" Spacing="6" />
                </StackPanel>
                <InfoBar x:Name="Status" IsClosable="False" IsOpen="True"
                         Title="Protected data"
                         Message="Chats, credentials, settings and project files are outside the cleanup scope." />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderThickness="0,1,0,0" Padding="32,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid MaxWidth="800" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock x:Name="Selection" Text="No files selected" VerticalAlignment="Center"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="ReviewButton" Grid.Column="1" Content="Review cleanup" IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}" Click="ReviewClicked" />
            </Grid>
        </Border>
    </Grid>
</Window>
